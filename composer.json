{
    "name": "assemblyai/assemblyai-php",
    "description": "Modern PHP SDK for AssemblyAI Speech-to-Text and Audio Intelligence API",
    "keywords": [
        "assemblyai",
        "speech-to-text",
        "transcription",
        "audio-intelligence",
        "lemur",
        "ai",
        "sdk"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "AssemblyAI PHP Community",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0 || ^1.1",
        "psr/http-message": "^1.0 || ^2.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "AssemblyAI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AssemblyAI\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
