{
    "name": "alex-volga/assemblyai-php",
    "description": "Modern PHP SDK for AssemblyAI Speech-to-Text and Audio Intelligence API",
    "keywords": [
        "assemblyai",
        "speech-to-text",
        "transcription",
        "audio-intelligence",
        "lemur",
        "ai",
        "sdk"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Oleksandr Volha",
            "email": "v.alex.lg@gmail.com",
            "homepage": "https://github.com/alex-volga",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/alex-volga/assemblyai-php",
    "support": {
        "issues": "https://github.com/alex-volga/assemblyai-php/issues",
        "source": "https://github.com/alex-volga/assemblyai-php"
    },
    "require": {
        "php": ">=8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0 || ^1.1",
        "psr/http-message": "^1.0 || ^2.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "AssemblyAI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AssemblyAI\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
